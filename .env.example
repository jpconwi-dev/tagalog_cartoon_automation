# --- App ---
APP_ENV=development
API_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db
TIMEZONE=Asia/Manila

# --- Free-only safety ---
FREE_ONLY=true
ALLOW_PAID_FALLBACK=false
DAILY_VIDEO_LIMIT=1
MAX_RETRIES_PER_PROVIDER=2
MAX_SCRIPT_TOKENS=3000
MAX_VIDEO_DURATION_SECONDS=300

# --- Video defaults ---
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
REVIEW_MODE=true
AUTO_PUBLISH=false

# --- Provider priority (comma separated) ---
PROVIDER_PRIORITY=cloudflare,gemini,huggingface,grok,local,template

# --- Provider credentials (placeholders; leave empty to disable) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
GROK_API_KEY=
# Set to true ONLY after you verified free API eligibility for that provider
CLOUDFLARE_FREE_VERIFIED=false
GEMINI_FREE_VERIFIED=false
HUGGINGFACE_FREE_VERIFIED=false
GROK_FREE_VERIFIED=false

# --- Phase 2: provider models (REQUIRED to enable a provider; pick from the provider's
# current catalog and confirm the model is usable on the FREE tier) ---
CLOUDFLARE_MODEL=
GEMINI_MODEL=
HUGGINGFACE_MODEL=
GROK_MODEL=
# Local OpenAI-compatible server (e.g. Ollama). Leave LOCAL_MODEL empty to disable.
LOCAL_MODEL=
LOCAL_BASE_URL=http://localhost:11434/v1

# --- Phase 2: router safety ---
PROVIDER_TIMEOUT_SECONDS=60
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=30
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=900
QUOTA_COOLDOWN_SECONDS=21600
PROVIDER_MIN_INTERVAL_SECONDS=6
